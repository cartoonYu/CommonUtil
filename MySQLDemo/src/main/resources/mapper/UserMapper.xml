<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.mysql.demo.mapper.UserMapper">

    <select id="findById"
            resultType="org.mysql.demo.entity.User">

        SELECT
        id,
        name,
        age
        FROM user
        WHERE id = #{id}

    </select>


    <select id="findAll"
            resultType="org.mysql.demo.entity.User">

        SELECT
        id,
        name,
        age
        FROM user

    </select>


    <insert id="insert"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO user (
        name,
        age
        )
        VALUES (
        #{name},
        #{age}
        )

    </insert>

</mapper>